1 VERSIONINFO
FILEVERSION @SLIC3R_FILE_VERSION_COMMA@
PRODUCTVERSION @SLIC3R_FILE_VERSION_COMMA@
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904E4"
  {
   VALUE "CompanyName", "@SLIC3R_PACKAGE_VENDOR@"
   VALUE "FileDescription", "@SLIC3R_APP_NAME@ G-code Viewer"
   VALUE "FileVersion", "@SLIC3R_DISPLAY_VERSION@"
   VALUE "ProductName", "@SLIC3R_APP_NAME@ G-code Viewer"
   VALUE "ProductVersion", "@SLIC3R_DISPLAY_VERSION@"
   VALUE "InternalName", "@SLIC3R_APP_NAME@ G-code Viewer"
   VALUE "LegalCopyright", ""
   VALUE "OriginalFilename", "magpie-gcodeviewer.exe"
  }
 }
 BLOCK "VarFileInfo"
 {
   VALUE "Translation", 0x409, 1252
 }
}
2 ICON "@SLIC3R_RESOURCES_DIR@/images/MagpieSlicer-gcodeviewer.ico"
1 24 "OrcaSlicer.manifest" 
