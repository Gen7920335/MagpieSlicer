{
    // Resin support: PrusaSlicer 2.9.6's SLA support points and support trees (Default and Branching),
    // printed with Orca's support toolpaths by the built-in "resin" support generator. Orca's own
    // support settings (Z/X/Y distances, interface layers and pattern, raft, threshold angle,
    // enforcers and blockers) still apply. The parameters below are PrusaSlicer's SLA support
    // settings, one set per tree strategy. Head and pillar sizes thinner than one support line are
    // widened to it.
    "id": "resin_support",
    "name": "Resin support", "name_ko": "레진 서포트",
    "version": "1.0.0",
    "params": {
        "enable":                                  { "type": "bool",   "default": false,     "label": "Use resin support", "label_ko": "레진 서포트 사용" },
        "tree_type":                               { "type": "string", "default": "default", "label": "Tree type (default or branching)", "label_ko": "트리 유형 (default 또는 branching)" },
        "points_density":                          { "type": "int",    "default": 100,       "unit": "%",   "label": "Support points density", "label_ko": "서포트 포인트 밀도" },
        "enforcers_only":                          { "type": "bool",   "default": false,     "label": "Support only in enforced regions", "label_ko": "강제 지정 영역에만 서포트" },

        "default_head_front_diameter":             { "type": "float",  "default": 0.4,       "unit": "mm",  "label": "Default: pinhead front diameter", "label_ko": "기본: 핀헤드 전면 직경" },
        "default_head_width":                      { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Default: pinhead width", "label_ko": "기본: 핀헤드 폭" },
        "default_pillar_diameter":                 { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Default: pillar diameter", "label_ko": "기본: 기둥 직경" },
        "default_small_pillar_diameter_percent":   { "type": "float",  "default": 50,        "unit": "%",   "label": "Default: small pillar diameter", "label_ko": "기본: 소형 기둥 직경 비율" },
        "default_max_bridges_on_pillar":           { "type": "int",    "default": 3,                        "label": "Default: max bridges on a pillar", "label_ko": "기본: 기둥당 최대 연결 가지 수" },
        "default_max_weight_on_model":             { "type": "float",  "default": 10.0,                     "label": "Default: max weight on model", "label_ko": "기본: 모델 위 최대 지지 하중" },
        "default_pillar_connection_mode":          { "type": "string", "default": "dynamic",                "label": "Default: pillar connection mode (dynamic, zigzag or cross)", "label_ko": "기본: 기둥 연결 방식 (dynamic, zigzag 또는 cross)" },
        "default_buildplate_only":                 { "type": "bool",   "default": false,                    "label": "Default: support on build plate only", "label_ko": "기본: 빌드 플레이트에만 서포트" },
        "default_pillar_widening_factor":          { "type": "float",  "default": 0.5,                      "label": "Default: pillar widening factor", "label_ko": "기본: 기둥 확장 계수" },
        "default_base_diameter":                   { "type": "float",  "default": 4.0,       "unit": "mm",  "label": "Default: support base diameter", "label_ko": "기본: 서포트 베이스 직경" },
        "default_base_height":                     { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Default: support base height", "label_ko": "기본: 서포트 베이스 높이" },
        "default_base_safety_distance":            { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Default: support base safety distance", "label_ko": "기본: 서포트 베이스 안전 거리" },
        "default_critical_angle":                  { "type": "float",  "default": 45,        "unit": "deg", "label": "Default: critical angle", "label_ko": "기본: 연결 임계각" },
        "default_max_bridge_length":               { "type": "float",  "default": 15.0,      "unit": "mm",  "label": "Default: max bridge length", "label_ko": "기본: 최대 브릿지 길이" },
        "default_max_pillar_link_distance":        { "type": "float",  "default": 10.0,      "unit": "mm",  "label": "Default: max pillar linking distance", "label_ko": "기본: 최대 기둥 연결 거리" },
        "default_object_elevation":                { "type": "float",  "default": 5.0,       "unit": "mm",  "label": "Default: object elevation", "label_ko": "기본: 출력물 띄우기" },

        "branching_head_front_diameter":           { "type": "float",  "default": 0.4,       "unit": "mm",  "label": "Branching: pinhead front diameter", "label_ko": "가지형: 핀헤드 전면 직경" },
        "branching_head_width":                    { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Branching: pinhead width", "label_ko": "가지형: 핀헤드 폭" },
        "branching_pillar_diameter":               { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Branching: pillar diameter", "label_ko": "가지형: 기둥 직경" },
        "branching_small_pillar_diameter_percent": { "type": "float",  "default": 50,        "unit": "%",   "label": "Branching: small pillar diameter", "label_ko": "가지형: 소형 기둥 직경 비율" },
        "branching_max_bridges_on_pillar":         { "type": "int",    "default": 2,                        "label": "Branching: max bridges on a pillar", "label_ko": "가지형: 기둥당 최대 연결 가지 수" },
        "branching_max_weight_on_model":           { "type": "float",  "default": 10.0,                     "label": "Branching: max weight on model", "label_ko": "가지형: 모델 위 최대 지지 하중" },
        "branching_pillar_connection_mode":        { "type": "string", "default": "dynamic",                "label": "Branching: pillar connection mode (dynamic, zigzag or cross)", "label_ko": "가지형: 기둥 연결 방식 (dynamic, zigzag 또는 cross)" },
        "branching_buildplate_only":               { "type": "bool",   "default": false,                    "label": "Branching: support on build plate only", "label_ko": "가지형: 빌드 플레이트에만 서포트" },
        "branching_pillar_widening_factor":        { "type": "float",  "default": 0.5,                      "label": "Branching: pillar widening factor", "label_ko": "가지형: 기둥 확장 계수" },
        "branching_base_diameter":                 { "type": "float",  "default": 4.0,       "unit": "mm",  "label": "Branching: support base diameter", "label_ko": "가지형: 서포트 베이스 직경" },
        "branching_base_height":                   { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Branching: support base height", "label_ko": "가지형: 서포트 베이스 높이" },
        "branching_base_safety_distance":          { "type": "float",  "default": 1.0,       "unit": "mm",  "label": "Branching: support base safety distance", "label_ko": "가지형: 서포트 베이스 안전 거리" },
        "branching_critical_angle":                { "type": "float",  "default": 45,        "unit": "deg", "label": "Branching: critical angle", "label_ko": "가지형: 연결 임계각" },
        "branching_max_bridge_length":             { "type": "float",  "default": 5.0,       "unit": "mm",  "label": "Branching: max bridge length", "label_ko": "가지형: 최대 브릿지 길이" },
        "branching_max_pillar_link_distance":      { "type": "float",  "default": 10.0,      "unit": "mm",  "label": "Branching: max pillar linking distance", "label_ko": "가지형: 최대 기둥 연결 거리" },
        "branching_object_elevation":              { "type": "float",  "default": 5.0,       "unit": "mm",  "label": "Branching: object elevation", "label_ko": "가지형: 출력물 띄우기" }
    },
    "rules": [
        // Priority 1 puts this rule above cura_support's: with both mods on, resin support is used.
        { "target": "support_generator", "value": "\"resin\"", "when": "resin_support.enable", "priority": 1 },
        // Slicing lifts only objects with support of their own (per-object enable_support), so an
        // object never prints in the air, and one with support enabled per object is still lifted.
        { "target": "object_elevation",
          "value": "if(resin_support.tree_type == \"branching\", resin_support.branching_object_elevation, resin_support.default_object_elevation)",
          "when": "resin_support.enable" }
    ]
}
