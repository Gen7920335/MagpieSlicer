{
    // Layer time blending: waits after short layers so neighbouring layer times stay close, which keeps the
    // cooling of each layer even. The waits are planned after the G-code is written, from the estimated
    // layer times; the layers before a long layer wait too, so the times ramp up to it. Off changes nothing.
    "id": "layer_time_blend",
    "name": "Layer time blending", "name_ko": "레이어 타임 블렌딩",
    "version": "1.0.0",
    "params": {
        "blend_type":     { "invalidates": ["none"], "type": "string", "default": "off",
                            "options": [ { "value": "off",    "label": "Off",    "label_ko": "끔" },
                                         { "value": "linear", "label": "Linear", "label_ko": "선형" },
                                         { "value": "log",    "label": "Log",    "label_ko": "로그" } ],
                            "label": "Layer time blending", "label_ko": "레이어 타임 블렌딩" },
        "max_diff":       { "invalidates": ["none"], "type": "float", "default": 5,  "unit": "s", "visible": "layer_time_blend.blend_type == \"linear\"",
                            "label": "Maximum layer time difference", "label_ko": "최대 레이어 시간 차이" },
        "max_ratio":      { "invalidates": ["none"], "type": "float", "default": 20, "unit": "%", "visible": "layer_time_blend.blend_type == \"log\"",
                            "label": "Maximum layer time change", "label_ko": "최대 레이어 시간 변화율" },
        "ease_layers":    { "invalidates": ["none"], "type": "int",   "default": 0,               "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "Transition easing layers", "label_ko": "전환 완화 레이어 수" },
        "start_layer":    { "invalidates": ["none"], "type": "int",   "default": 2,               "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "First blended layer", "label_ko": "블렌딩 시작 레이어" },
        "wait_cap":       { "invalidates": ["none"], "type": "float", "default": 0,  "unit": "s", "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "Maximum wait per layer (0 = no limit)", "label_ko": "레이어당 최대 대기 (0 = 제한 없음)" },
        "warn_total_pct": { "invalidates": ["none"], "type": "float", "default": 15, "unit": "%", "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "Warn when waits exceed this share of the print time", "label_ko": "대기 합계가 출력 시간의 이 비율을 넘으면 경고" },
        "warn_single":    { "invalidates": ["none"], "type": "float", "default": 60, "unit": "s", "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "Warn when one wait exceeds", "label_ko": "단일 대기가 이 시간을 넘으면 경고" },
        "wait_at":        { "invalidates": ["none"], "type": "string", "default": "tower", "visible": "layer_time_blend.blend_type != \"off\"",
                            "options": [ { "value": "tower",       "label": "Layer time tower", "label_ko": "레이어 타임 균일화 타워" },
                                         { "value": "purge_tower", "label": "Over the purge tower", "label_ko": "퍼지 타워 위" },
                                         { "value": "park",        "label": "Park position",    "label_ko": "파킹 위치" },
                                         { "value": "in_place",    "label": "In place",         "label_ko": "제자리" } ],
                            "label": "Wait position", "label_ko": "대기 위치" },
        "tower_size":     { "invalidates": ["none"], "type": "float", "default": 15, "unit": "mm",
                            "visible": "layer_time_blend.blend_type != \"off\" and layer_time_blend.wait_at == \"tower\"",
                            "label": "Tower size", "label_ko": "타워 크기" },
        "in_place_max":   { "invalidates": ["none"], "type": "float", "default": 2,  "unit": "s",
                            "visible": "layer_time_blend.blend_type != \"off\" and (layer_time_blend.wait_at == \"park\" or layer_time_blend.wait_at == \"purge_tower\")",
                            "label": "Shorter waits stay in place", "label_ko": "이보다 짧은 대기는 제자리에서" },
        "park_x":         { "invalidates": ["none"], "type": "float", "default": -1, "unit": "mm", "scope": "printer",
                            "visible": "layer_time_blend.wait_at == \"park\" or layer_time_blend.wait_at == \"purge_tower\"",
                            "label": "Layer time park position X (-1 = rear left)", "label_ko": "레이어 타임 파킹 위치 X (-1 = 왼쪽 뒤)" },
        "park_y":         { "invalidates": ["none"], "type": "float", "default": -1, "unit": "mm", "scope": "printer",
                            "visible": "layer_time_blend.wait_at == \"park\" or layer_time_blend.wait_at == \"purge_tower\"",
                            "label": "Layer time park position Y (-1 = rear left)", "label_ko": "레이어 타임 파킹 위치 Y (-1 = 왼쪽 뒤)" },
        // Used only with the low temperature support interface, whose temperature waits the estimate otherwise counts as no time.
        "heat_rate":      { "invalidates": ["none"], "type": "float", "default": 2, "unit": "degC/s", "scope": "printer",
                            "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "Nozzle heating rate (for temperature wait estimates)", "label_ko": "노즐 가열 속도 (온도 대기 추정용)" },
        "cool_rate":      { "invalidates": ["none"], "type": "float", "default": 1, "unit": "degC/s", "scope": "printer",
                            "visible": "layer_time_blend.blend_type != \"off\"",
                            "label": "Nozzle cooling rate (for temperature wait estimates)", "label_ko": "노즐 냉각 속도 (온도 대기 추정용)" }
    },
    "rules": [
        { "target": "layer_time_planner",           "value": "if(layer_time_blend.blend_type == \"off\", \"\", \"blend\")" },
        { "target": "layer_time_blend_log",         "value": "layer_time_blend.blend_type == \"log\"" },
        { "target": "layer_time_blend_max_diff",    "value": "layer_time_blend.max_diff" },
        { "target": "layer_time_blend_max_ratio",   "value": "layer_time_blend.max_ratio" },
        { "target": "layer_time_blend_ease_layers", "value": "layer_time_blend.ease_layers" },
        { "target": "layer_time_blend_start_layer", "value": "layer_time_blend.start_layer" },
        { "target": "layer_time_blend_wait_cap",    "value": "layer_time_blend.wait_cap" },
        { "target": "layer_time_blend_warn_total",  "value": "layer_time_blend.warn_total_pct" },
        { "target": "layer_time_blend_warn_single", "value": "layer_time_blend.warn_single" },
        { "target": "layer_time_blend_wait_at",     "value": "layer_time_blend.wait_at" },
        { "target": "layer_time_blend_tower_size",  "value": "layer_time_blend.tower_size" },
        { "target": "layer_time_blend_in_place_max","value": "layer_time_blend.in_place_max" },
        { "target": "layer_time_blend_park_x",      "value": "layer_time_blend.park_x" },
        { "target": "layer_time_blend_park_y",      "value": "layer_time_blend.park_y" },
        { "target": "layer_time_blend_heat_rate",   "value": "layer_time_blend.heat_rate" },
        { "target": "layer_time_blend_cool_rate",   "value": "layer_time_blend.cool_rate" }
    ]
}
