{
    // Snapmaker U1 start G-code guard (Magpie line 1). On a U1 only: a start G-code without the stock
    // pre-print sequence (PRINT_START, homing, bed mesh, purge line) is replaced by it, and a start G-code
    // that would move before homing gets a G28 after PRINT_START. The stock U1 profiles already carry the
    // sequence, so with them nothing changes.
    "id": "snapmaker_u1",
    "name": "Snapmaker U1", "name_ko": "Snapmaker U1",
    "version": "1.0.0",
    "params": {
        "start_guard": { "type": "bool", "default": true, "scope": "printer", "label": "Guard the start G-code (U1)", "label_ko": "시작 G-code 보호 (U1)" }
    },
    "rules": [
        { "target": "snapmaker_u1_start_guard", "value": "snapmaker_u1.start_guard" }
    ]
}
