{
    // Low temperature support interface (Magpie line 1): on a single nozzle, support interfaces print at their own
    // lower temperature, so they stick less to the model. The support prints after the object on each layer, the
    // nozzle waits for the interface temperature (or cools while printing a temperature drop tower), and the next other
    // extrusion heats back. Optional nozzle cooling with the auxiliary fan and brushing on a nozzle brush. The defaults
    // change nothing.
    "id": "low_temp_interface",
    "name": "Low temperature support interface", "name_ko": "저온 서포트 접점",
    "version": "1.0.0",
    "params": {
        "enable":          { "invalidates": ["none"], "type": "bool",  "default": false, "label": "Low temperature support interface", "label_ko": "저온 서포트 접점" },
        "temperature":     { "invalidates": ["none"], "type": "int",   "default": 170,   "unit": "degC", "label": "Support interface temperature", "label_ko": "서포트 접점 온도" },
        "heating_time":    { "invalidates": ["none"], "type": "float", "default": 5,     "unit": "s",    "label": "Heating time before the model resumes", "label_ko": "모델 출력 재개 전 가열 시간" },
        "aux_fan":         { "invalidates": ["none"], "type": "bool",  "default": false, "label": "Cool the nozzle with the auxiliary fan (air duct adapter required)", "label_ko": "보조 팬으로 노즐 냉각 (에어 덕트 어댑터 필요)" },
        "aux_fan_speed":   { "invalidates": ["none"], "type": "int",   "default": 100,   "unit": "%",    "label": "Auxiliary fan speed", "label_ko": "보조 팬 속도" },
        "brush":           { "invalidates": ["none"], "type": "bool",  "default": false, "label": "Wipe the nozzle on the brush after cooling", "label_ko": "냉각 후 브러시에 노즐 닦기" },
        "tower":           { "invalidates": ["none"], "type": "bool",  "default": false, "label": "Cool down on a temperature drop tower (without a brush)", "label_ko": "온도 강하 타워를 출력하며 냉각 (브러시 없을 때)" }
    },
    "rules": [
        { "target": "single_nozzle_low_temperature_interface",                       "value": "low_temp_interface.enable" },
        { "target": "support_interface_temperature",                                 "value": "low_temp_interface.temperature" },
        { "target": "support_interface_heating_time",                                "value": "low_temp_interface.heating_time" },
        { "target": "support_interface_auxiliary_fan_cooling_on_temperature_change", "value": "low_temp_interface.aux_fan" },
        { "target": "support_interface_auxiliary_fan_speed",                         "value": "low_temp_interface.aux_fan_speed" },
        { "target": "support_interface_nozzle_wiping_on_temperature_change",         "value": "low_temp_interface.brush" },
        { "target": "support_interface_temperature_drop_tower",                      "value": "low_temp_interface.tower" }
    ]
}
