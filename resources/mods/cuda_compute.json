{
    // CUDA test mod: runs four slicing calculations on an NVIDIA GPU (facet layer ranges, rectilinear
    // infill crossings, Lightning infill boundary distances, tree support contact points), so slicing
    // with CUDA on and off can be compared. The G-code is the same either way. Off never loads the
    // CUDA driver. Needs only the NVIDIA driver, not the CUDA toolkit; without it the CPU is used.
    "id": "cuda_compute",
    "name": "CUDA compute (experimental)", "name_ko": "CUDA 연산 (실험)",
    "version": "1.0.0",
    "params": {
        "mode": { "invalidates": ["none"], "type": "string", "default": "off",
                  "options": [ { "value": "off", "label": "Off",     "label_ko": "끔" },
                               { "value": "on",  "label": "On (checked against the CPU)", "label_ko": "켬 (CPU로 검증)" },
                               { "value": "max", "label": "Max GPU", "label_ko": "최대 GPU" } ],
                  "label": "CUDA compute", "label_ko": "CUDA 연산" }
    },
    "rules": [
        { "target": "cuda_compute", "value": "cuda_compute.mode" }
    ]
}
