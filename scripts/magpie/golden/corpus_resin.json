{
    "description": "Resin support corpus: the resin support mod (mods/resin_support, PrusaSlicer 2.9.6 SLA points and trees printed through Orca's normal support) with both tree types, the object lift with and without raft, threshold angle, pillar and head settings, build plate only, a tree support type (ignored), interfaces, support off, enforcers only, several models and the X1C. Used as the gate when resin support moved from the core into its native mod: the built-in and the mod build must give identical normalized G-code (the '; mods:' header line aside).",
    "printers": {
        "u1": {
            "machine": "presets/u1_04_machine.json",
            "process": "presets/u1_04_process.json",
            "filaments": [
                "presets/u1_pla.json"
            ],
            "bed_type": "High Temp Plate"
        },
        "x1c": {
            "machine": "presets/x1c_04_machine.json",
            "process": "presets/x1c_04_process.json",
            "filaments": [
                "presets/x1c_pla.json"
            ],
            "bed_type": "Textured PEI Plate"
        }
    },
    "cases": [
        {
            "name": "overhang_default",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "mod_settings": "{\"resin_support.enable\":true}"
            }
        },
        {
            "name": "overhang_branching",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "mod_settings": "{\"resin_support.enable\":true,\"resin_support.tree_type\":\"branching\"}"
            }
        },
        {
            "name": "overhang_no_lift",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "mod_settings": "{\"resin_support.enable\":true,\"resin_support.default_object_elevation\":0}"
            }
        },
        {
            "name": "overhang_branching_no_lift_raft",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "raft_layers": "2",
                "mod_settings": "{\"resin_support.enable\":true,\"resin_support.tree_type\":\"branching\",\"resin_support.branching_object_elevation\":0}"
            }
        },
        {
            "name": "overhang_raft_lift",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "raft_layers": "3",
                "mod_settings": "{\"resin_support.enable\":true,\"resin_support.default_object_elevation\":2.5}"
            }
        },
        {
            "name": "overhang_threshold_30",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "support_threshold_angle": "30",
                "mod_settings": "{\"resin_support.enable\":true,\"resin_support.points_density\":60}"
            }
        },
        {
            "name": "overhang_zigzag_wide",
