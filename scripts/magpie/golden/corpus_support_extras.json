                "mod_settings": "{\"support_extras.sublayer_start\":2,\"support_extras.sublayer_end\":3,\"support_extras.sublayer_angle\":30}"
            }
        },
        {
            "name": "overhang_sublayer_hybrid_triangles",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
