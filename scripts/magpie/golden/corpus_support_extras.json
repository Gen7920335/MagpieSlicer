{
    "description": "Support extras corpus: the support extras mod (mods/support_extras) with every support generator: interface pattern, interface sublayers (pattern, angle, temperature, also with the low temperature interface), normal and tree wall counts. Used as the gate when support extras moved from the core's settings into its native mod: the built-in and the mod build must give identical normalized G-code (the '; mods:' header line aside).",
    "printers": {
        "u1": {
            "machine": "presets/u1_04_machine.json",
            "process": "presets/u1_04_process.json",
            "filaments": [
                "presets/u1_pla.json"
            ],
            "bed_type": "High Temp Plate"
        },
        "x1c": {
            "machine": "presets/x1c_04_machine.json",
            "process": "presets/x1c_04_process.json",
            "filaments": [
                "presets/x1c_pla.json"
            ],
            "bed_type": "Textured PEI Plate"
        }
    },
    "cases": [
        {
            "name": "overhang_triangles",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "support_interface_top_layers": "2",
                "mod_settings": "{\"support_extras.interface_pattern\":\"triangles\"}"
            }
        },
        {
            "name": "overhang_concentric_bottom",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "support_interface_top_layers": "2",
                "support_interface_bottom_layers": "2",
                "support_on_build_plate_only": "0",
                "mod_settings": "{\"support_extras.interface_pattern\":\"concentric\"}"
            }
        },
        {
            "name": "overhang_sublayer_normal",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
                "enable_support": "1",
                "support_type": "normal(auto)",
                "support_interface_top_layers": "4",
                "mod_settings": "{\"support_extras.sublayer_start\":2,\"support_extras.sublayer_end\":3,\"support_extras.sublayer_pattern\":\"grid\",\"support_extras.sublayer_angle\":45}"
            }
        },
        {
            "name": "overhang_sublayer_slim",
            "printer": "u1",
            "model": "tests/data/overhang.obj",
            "process": {
