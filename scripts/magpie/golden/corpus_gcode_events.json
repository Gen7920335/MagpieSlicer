    "support_interface_top_layers": "3",
    "support_interface_bottom_layers": "0",
    "mod_settings": "{\"low_temp_interface.enable\": true, \"low_temp_interface.temperature\": 175, \"low_temp_interface.tower\": true}"
   }
  },
  {
