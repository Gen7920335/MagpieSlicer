{
 "description": "G-code event mods (gcode.events slot, M6): the low temperature support interface with its temperature drop tower, auxiliary fan, nozzle brush and interface sublayer temperatures (mods/low_temp_interface, mods/support_extras), and the Snapmaker U1 start G-code guard (mods/snapmaker_u1). Compared built-in (before M6) against the native mods, byte for byte apart from the '; mods:' line. LESIC and the interface grid run only from the application's Calibration menu, so they are checked by test_low_temp_calibration.cpp instead. The brush and cooling position are given as line 1's printer settings, which the built-in version reads and the mod version migrates into its printer parameters (LegacySettings).",
 "printers": {
  "u1": {
   "machine": "presets/u1_04_machine.json",
   "process": "presets/u1_04_process.json",
   "filaments": [
    "presets/u1_pla.json"
   ],
   "bed_type": "High Temp Plate"
  },
  "u1mixed": {
   "machine": "presets/u1_04_machine.json",
   "process": "presets/u1_04_process.json",
   "filaments": [
    "presets/u1_pla.json",
    "presets/u1_pla_2.json",
    "presets/u1_pla_3.json",
    "presets/u1_pla_4.json"
   ],
   "bed_type": "High Temp Plate"
  },
  "x1c": {
   "machine": "presets/x1c_04_machine.json",
   "process": "presets/x1c_04_process.json",
   "filaments": [
    "presets/x1c_pla.json"
   ],
   "bed_type": "Textured PEI Plate"
  }
 },
 "cases": [
