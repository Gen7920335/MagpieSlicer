    "support_interface_top_layers": "2",
    "mod_settings": "{\"low_temp_interface.enable\": true, \"low_temp_interface.tower\": true, \"low_temp_interface.aux_fan\": true, \"low_temp_interface.aux_fan_speed\": 80}"
   }
  },
