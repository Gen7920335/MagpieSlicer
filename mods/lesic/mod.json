{
    // LESIC ring calibration (Magpie line 1), its G-code: a temperature per band of layers, a wall speed that follows
    // the angle around the ring, and the labels and inner brim on the first layer. The application's Calibration menu
    // starts it (the ring model and its values, from the entry declared under "gui"); this native mod on the
    // gcode.events slot prints it. No parameters.
    "id": "lesic",
    "name": "LESIC ring calibration", "name_ko": "LESIC 링 보정",
    "version": "2.0.0",
    "api": { "major": 1, "min_minor": 1 },
    "binary": "lesic",
    "slots": [ { "slot": "gcode.events", "version": 1, "impl": "lesic" } ],
    "thread_safe": true,
    // The Calibration menu entry; the application owns its dialog and ring model and shows the entry only while this
    // mod is loaded.
    "gui": { "calibrations": [ { "id": "lesic", "label": "LESIC", "label_ko": "LESIC",
                                 "description": "Low-temperature support interface calibration",
                                 "description_ko": "저온 서포트 접점 보정" } ] }
}
