{
    "description": "The overhang model with Cura support on: support and its interface are printed, by this mod.",
    "args": [
        "--load-settings",
        "presets/machine.json;presets/process.json",
        "overhang.obj"
    ],
    "contains": [
        ";TYPE:Support",
        ";TYPE:Support interface",
        "cura_support 1.3.0"
    ]
}
