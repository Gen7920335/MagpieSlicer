{
    // Cura support: CuraEngine's normal support areas (ported from CuraEngine 47b0388), printed with
    // Orca's support toolpaths. A native mod filling the support.areas slot as the "cura" generator.
    // Orca's own support settings (type, Z/XY distances, interface layers, expansion, build plate only,
    // threshold angle) still apply; the parameters below are the CuraEngine settings Orca has no setting for.
    "id": "cura_support",
    "name": "Cura support", "name_ko": "Cura 서포트",
    "version": "1.3.0",
    "api": { "major": 1, "min_minor": 0 },
    "binary": "cura_support",
    // Picked for an object's support while enable holds; mixed_support (priority 2) and resin_support (1) go first.
    // The menu adds its entries to the support type dropdown; picking one turns enable on and the other support
    // mods off (ModHost/SupportMenu.hpp).
    "slots": [ { "slot": "support.areas", "version": 1, "impl": "cura", "when": "cura_support.enable",
                 "menu": { "param": "enable", "entries": [
                     { "label": "Cura (auto)", "label_ko": "Cura (자동)", "support_type": "normal(auto)" },
                     { "label": "Cura (manual)", "label_ko": "Cura (수동)", "support_type": "normal(manual)" } ] } } ],
    "thread_safe": true,
    "params": {
        "enable":                       { "invalidates": ["posSupportMaterial"], "type": "bool",  "default": false, "label": "Use Cura support", "label_ko": "Cura 서포트 사용" },
        "join_distance":                { "invalidates": ["posSupportMaterial"], "type": "float", "default": 2.0,   "unit": "mm",  "label": "Support join distance", "label_ko": "서포트 연결 거리", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "min_feature_width":            { "invalidates": ["posSupportMaterial"], "type": "float", "default": 0.0,   "unit": "mm",  "label": "Minimum feature width (0 = 85% of the nozzle size)", "label_ko": "최소 형상 폭 (0 = 노즐 크기의 85%)", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "z_overrides_xy":               { "invalidates": ["posSupportMaterial"], "type": "bool",  "default": true,  "label": "Z distance overrides X/Y distance", "label_ko": "Z 거리가 X/Y 거리보다 우선", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "xy_distance_overhang":         { "invalidates": ["posSupportMaterial"], "type": "float", "default": 0.2,   "unit": "mm",  "label": "Minimum X/Y distance at overhangs", "label_ko": "오버행의 최소 X/Y 거리", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "stair_step_height":            { "invalidates": ["posSupportMaterial"], "type": "float", "default": 0.3,   "unit": "mm",  "label": "Stair step height", "label_ko": "계단 높이", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "stair_step_width":             { "invalidates": ["posSupportMaterial"], "type": "float", "default": 5.0,   "unit": "mm",  "label": "Stair step maximum width", "label_ko": "계단 최대 폭", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "stair_step_min_slope":         { "invalidates": ["posSupportMaterial"], "type": "float", "default": 10.0,  "unit": "deg", "label": "Stair step minimum slope angle", "label_ko": "계단 최소 경사각", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "minimum_support_area":         { "invalidates": ["posSupportMaterial"], "type": "float", "default": 0.0,   "unit": "mm2", "label": "Minimum support area", "label_ko": "최소 서포트 면적", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "minimum_roof_area":            { "invalidates": ["posSupportMaterial"], "type": "float", "default": 1.0,   "unit": "mm2", "label": "Minimum roof area", "label_ko": "최소 지붕 면적", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "minimum_bottom_area":          { "invalidates": ["posSupportMaterial"], "type": "float", "default": 1.0,   "unit": "mm2", "label": "Minimum floor area", "label_ko": "최소 바닥 면적", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "roof_offset":                  { "invalidates": ["posSupportMaterial"], "type": "float", "default": 0.0,   "unit": "mm",  "label": "Roof horizontal expansion", "label_ko": "지붕 수평 확장", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "bottom_offset":                { "invalidates": ["posSupportMaterial"], "type": "float", "default": 0.0,   "unit": "mm",  "label": "Floor horizontal expansion", "label_ko": "바닥 수평 확장", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "use_towers":                   { "invalidates": ["posSupportMaterial"], "type": "bool",  "default": false, "label": "Use towers", "label_ko": "타워 사용", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "tower_diameter":               { "invalidates": ["posSupportMaterial"], "type": "float", "default": 3.0,   "unit": "mm",  "label": "Tower diameter", "label_ko": "타워 직경", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable and cura_support.use_towers" },
        "tower_max_supported_diameter": { "invalidates": ["posSupportMaterial"], "type": "float", "default": 3.0,   "unit": "mm",  "label": "Maximum tower-supported diameter", "label_ko": "타워로 지지하는 최대 직경", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable and cura_support.use_towers" },
        "tower_roof_angle":             { "invalidates": ["posSupportMaterial"], "type": "float", "default": 65.0,  "unit": "deg", "label": "Tower roof angle", "label_ko": "타워 지붕 각도", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable and cura_support.use_towers" },
        "conical_enabled":              { "invalidates": ["posSupportMaterial"], "type": "bool",  "default": false, "label": "Conical support", "label_ko": "원뿔형 서포트", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" },
        "conical_angle":                { "invalidates": ["posSupportMaterial"], "type": "float", "default": 30.0,  "unit": "deg", "label": "Conical support angle", "label_ko": "원뿔형 서포트 각도", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable and cura_support.conical_enabled" },
        "conical_min_width":            { "invalidates": ["posSupportMaterial"], "type": "float", "default": 5.0,   "unit": "mm",  "label": "Conical support minimum width", "label_ko": "원뿔형 서포트 최소 폭", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable and cura_support.conical_enabled" },
        "solid_first_layer":            { "invalidates": ["posSupportMaterial"], "type": "bool",  "default": false, "label": "Solid first support layer", "label_ko": "서포트 첫 레이어 채움", "ui": { "page": "Support", "group": "Cura support", "group_after": "Support" }, "visible": "(enable_support or raft_layers > 0) and cura_support.enable" }
    },
    // Line 1 settings.
    "legacy_keys": {
        "cura_support_join_distance": "join_distance",
        "cura_solid_support_raft": "solid_first_layer"
    }
}
