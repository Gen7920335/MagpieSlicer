{
    // Low temperature support interface (Magpie line 1): on a single nozzle, support interfaces print at their own
    // lower temperature, so they stick less to the model. The support prints after the object on each layer, the
    // nozzle waits for the interface temperature (or cools while printing a temperature drop tower), and the next other
    // extrusion heats back. Optional nozzle cooling with the auxiliary fan and brushing on a nozzle brush. A native mod
    // on the gcode.events slot; the defaults change nothing.
    "id": "low_temp_interface",
    "name": "Low temperature support interface", "name_ko": "저온 서포트 접점",
    "version": "2.0.1",
    "api": { "major": 1, "min_minor": 1 },
    "binary": "low_temp_interface",
    "slots": [ { "slot": "gcode.events", "version": 1, "impl": "low_temp_interface" } ],
    "thread_safe": true,
    "params": {
        "enable":          { "invalidates": ["psWipeTower"], "type": "bool",  "default": false, "label": "Low temperature support interface", "label_ko": "저온 서포트 접점", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        "temperature":     { "invalidates": ["psWipeTower"], "type": "int",   "default": 170,   "unit": "degC", "label": "Support interface temperature", "label_ko": "서포트 접점 온도", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        "heating_time":    { "invalidates": ["psWipeTower"], "type": "float", "default": 5,     "unit": "s",    "label": "Heating time before the model resumes", "label_ko": "모델 출력 재개 전 가열 시간", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        "aux_fan":         { "invalidates": ["psWipeTower"], "type": "bool",  "default": false, "label": "Cool the nozzle with the auxiliary fan (air duct adapter required)", "label_ko": "보조 팬으로 노즐 냉각 (에어 덕트 어댑터 필요)", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        "aux_fan_speed":   { "invalidates": ["psWipeTower"], "type": "int",   "default": 100,   "unit": "%",    "label": "Auxiliary fan speed", "label_ko": "보조 팬 속도", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        "brush":           { "invalidates": ["psWipeTower"], "type": "bool",  "default": false, "label": "Wipe the nozzle on the brush after cooling", "label_ko": "냉각 후 브러시에 노즐 닦기", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        "tower":           { "invalidates": ["psWipeTower"], "type": "bool",  "default": false, "label": "Cool down on a temperature drop tower (without a brush)", "label_ko": "온도 강하 타워를 출력하며 냉각 (브러시 없을 때)", "ui": { "page": "Support", "group": "Low-temperature support interface", "group_after": "Filament for Supports" } },
        // The printer's: where the auxiliary fan cools the nozzle (negative: the rear left corner of the bed) and the
        // nozzle brush (both ends set and some round trips, or no brushing). Line 1's printer settings.
        "cooling_position_x": { "invalidates": ["psGCodeExport"], "type": "float", "default": -1, "unit": "mm", "scope": "printer", "label": "Nozzle cooling position X (-1 = rear left)", "label_ko": "노즐 냉각 위치 X (-1 = 왼쪽 뒤)", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "cooling_position_y": { "invalidates": ["psGCodeExport"], "type": "float", "default": -1, "unit": "mm", "scope": "printer", "label": "Nozzle cooling position Y (-1 = rear left)", "label_ko": "노즐 냉각 위치 Y (-1 = 왼쪽 뒤)", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "brush_start_x":      { "invalidates": ["psGCodeExport"], "type": "float", "default": -1, "unit": "mm", "scope": "printer", "label": "Nozzle brush start X", "label_ko": "노즐 브러시 시작 X", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "brush_start_y":      { "invalidates": ["psGCodeExport"], "type": "float", "default": -1, "unit": "mm", "scope": "printer", "label": "Nozzle brush start Y", "label_ko": "노즐 브러시 시작 Y", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "brush_end_x":        { "invalidates": ["psGCodeExport"], "type": "float", "default": -1, "unit": "mm", "scope": "printer", "label": "Nozzle brush end X", "label_ko": "노즐 브러시 끝 X", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "brush_end_y":        { "invalidates": ["psGCodeExport"], "type": "float", "default": -1, "unit": "mm", "scope": "printer", "label": "Nozzle brush end Y", "label_ko": "노즐 브러시 끝 Y", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "brush_repetitions":  { "invalidates": ["psGCodeExport"], "type": "int",   "default": 0,  "scope": "printer", "label": "Nozzle brush round trips (0 = no brushing)", "label_ko": "노즐 브러시 왕복 횟수 (0 = 닦지 않음)", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } },
        "brush_speed":        { "invalidates": ["psGCodeExport"], "type": "float", "default": 80, "unit": "mm/s", "scope": "printer", "label": "Nozzle brush speed", "label_ko": "노즐 브러시 속도", "ui": { "page": "Basic information", "group": "Nozzle cooling and brush", "group_after": "Extruder Clearance" } }
    },
    // Line 1 settings (line 2 saved them as the rule wrote them); their defaults carry nothing. Positions are "XxY", mm.
    "legacy_keys": {
        "single_nozzle_low_temperature_interface": {"param": "enable", "saved_default": "0"},
        "support_interface_temperature": {"param": "temperature", "saved_default": "170"},
        "support_interface_heating_time": {"param": "heating_time", "saved_default": "5"},
        "support_interface_auxiliary_fan_cooling_on_temperature_change": {"param": "aux_fan", "saved_default": "0"},
        "support_interface_auxiliary_fan_speed": {"param": "aux_fan_speed", "saved_default": "100"},
        "support_interface_nozzle_wiping_on_temperature_change": {"param": "brush", "saved_default": "0"},
        "support_interface_temperature_drop_tower": {"param": "tower", "saved_default": "0"},
        "support_interface_brush_repetitions": {"param": "brush_repetitions", "saved_default": "0"},
        "support_interface_brush_speed": {"param": "brush_speed", "saved_default": "80"},
        "support_interface_cooling_position": {"point": "cooling_position"},
        "support_interface_brush_start": {"point": "brush_start"},
        "support_interface_brush_end": {"point": "brush_end"}
    }
}
