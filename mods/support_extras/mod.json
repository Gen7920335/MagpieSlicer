{
    // Support toolpath extras from Magpie line 1, for every support generator: a triangle (or other)
    // interface pattern, interface sublayers printed with their own pattern, angle and temperature, and
    // separate wall counts for normal and tree support. The defaults change nothing. A native mod filling
    // the support.style slot; the core prints what it answers. The parameters except the temperature are
    // read per object, so an object can set its own.
    "id": "support_extras",
    "name": "Support extras", "name_ko": "서포트 추가 설정",
    "version": "2.1.1",
    "api": { "major": 1, "min_minor": 0 },
    "binary": "support_extras",
    "slots": [ { "slot": "support.style", "version": 1, "impl": "extras" } ],
    "thread_safe": true,
    "params": {
        "interface_pattern": { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "string", "default": "",  "label": "Interface pattern (triangles, grid, rectilinear, concentric; empty = Orca's)", "label_ko": "접점 패턴 (triangles, grid, rectilinear, concentric; 비우면 오르카 설정)", "ui": { "after": "support_interface_pattern" } },
        "sublayer_start":    { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "int",    "default": 0,   "label": "Interface sublayer: first layer from the contact (2 or more; 0 = off)", "label_ko": "접점 서브레이어: 접촉면부터 첫 레이어 (2 이상; 0 = 끔)", "ui": { "after": "support_interface_pattern" } },
        "sublayer_end":      { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "int",    "default": 0,   "label": "Interface sublayer: last layer from the contact", "label_ko": "접점 서브레이어: 접촉면부터 마지막 레이어", "ui": { "after": "support_interface_pattern" } },
        "sublayer_pattern":  { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "string", "default": "",  "label": "Interface sublayer pattern (rectilinear, grid, triangles, concentric)", "label_ko": "접점 서브레이어 패턴 (rectilinear, grid, triangles, concentric)", "ui": { "after": "support_interface_pattern" } },
        "sublayer_angle":    { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "float",  "default": 0,   "unit": "deg", "label": "Interface sublayer angle", "label_ko": "접점 서브레이어 각도", "ui": { "after": "support_interface_pattern" } },
        "sublayer_temperature": { "invalidates": ["posSupportMaterial"], "type": "int", "default": 0,   "unit": "°C", "label": "Interface sublayer nozzle temperature (0 = filament temperature)", "label_ko": "접점 서브레이어 노즐 온도 (0 = 필라멘트 온도)", "ui": { "after": "support_interface_pattern" } },
        "normal_wall_loops": { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "int",    "default": -1,  "label": "Normal support walls (0-10; -1 = Orca's)", "label_ko": "일반 서포트 벽 수 (0-10; -1 = 오르카 설정)", "ui": { "after": "support_bottom_z_distance" } },
        "tree_wall_loops":   { "scope": "object", "invalidates": ["posSupportMaterial"], "type": "int",    "default": -1,  "label": "Tree support walls per branch (1-10; -1 = Orca's)", "label_ko": "트리 서포트 가지당 벽 수 (1-10; -1 = 오르카 설정)", "ui": { "after": "tree_support_wall_count" } }
    },
    // Line 1 settings; their defaults carry nothing.
    "legacy_keys": {
        "support_interface_sublayer_angle": {"param": "sublayer_angle", "saved_default": "0"},
        "support_interface_sublayer_temperature": {"param": "sublayer_temperature", "saved_default": "0"}
    }
}
